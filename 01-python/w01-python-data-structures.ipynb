    "print(\"Char Index Mapping:\", char_counts)\n",
    "\n",
    "# Inverting a Dictionary (Value -> Key mapping)\n",
    "original_dict = {\"a\": 1, \"b\": 2, \"c\": 3}\n",
    "inverted_dict = {v: k for k, v in original_dict.items()}\n",
    "print(\"Inverted Dict:\", inverted_dict)"
